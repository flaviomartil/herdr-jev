# ==============================================================================
# Herdr-Jev Environment Configuration Matrix
# ==============================================================================
# +-----------------------------+------------------------------------+---------------+------------------------------------------------------+
# | Variable                    | Allowed Values                     | Default       | Purpose / Behavioral Mode                            |
# +-----------------------------+------------------------------------+---------------+------------------------------------------------------+
# | TYPESAFE_API_KEY            | string                             | vault/local   | TypeSafe Jev System One semantic triage key (~260ms) |
# | HERDR_JEV_ALLOW_ALIASES     | 0, 1, false, true                  | 0 (Disabled)  | Security gate: enable custom client alias binaries   |
# | HERDR_JEV_CROSS_HARNESS     | 0, auto, list, mapping             | 0 (Disabled)  | Delegation scope: 0=self-only, auto=Jev, or peers    |
# | HERDR_JEV_SPLIT_SUBAGENTS   | 1 (split), 0 (inline)              | 1 (in Herdr)  | Subagent UX: split pane vs live native harness CLI   |
# | HERDR_JEV_SPLIT_DIRECTION   | auto, right, down                  | auto          | Split direction: Jev role heuristics or explicit     |
# | AI_HARNESS_ROOT             | filesystem path                    | auto-discover | Path to ai-harness-core repository for memories      |
# | HERDR_BIN_PATH              | executable path                    | herdr         | Path to Herdr multiplexer binary in system PATH      |
# +-----------------------------+------------------------------------+---------------+------------------------------------------------------+
# Copy this file to .env or run: herdr-jev detect --auto-config

# ------------------------------------------------------------------------------
# 1. TypeSafe Jev System One API (Required for Semantic Triage)
# ------------------------------------------------------------------------------
# API Key for TypeSafe Jev System One triage gate.
# If not provided, Herdr-Jev attempts to resolve via:
#   vault get AI-Providers/TypeSafe
# If resolution fails, a deterministic local heuristic fallback is used.
TYPESAFE_API_KEY=your_typesafe_api_key_here

# ------------------------------------------------------------------------------
# 2. AI-Harness Integration (Optional)
# ------------------------------------------------------------------------------
# Custom path to ai-harness-core repository for auto-improvement logging.
# If omitted, auto-discovers ../ai-harness-core or ~/.ai-harness
AI_HARNESS_ROOT=
AI_HARNESS_CORE_PATH=

# ------------------------------------------------------------------------------
# 3. Herdr Binary & Plugin Configuration (Optional)
# ------------------------------------------------------------------------------
# Path to the herdr binary (defaults to searching PATH)
HERDR_BIN_PATH=herdr

# Plugin ID override (defaults to herdr-jev)
HERDR_PLUGIN_ID=herdr-jev

# Global binary path override
HERDR_JEV_BIN=

# ------------------------------------------------------------------------------
# 4. Client Aliases & Custom Binary Wrappers (Optional)
# ------------------------------------------------------------------------------
# Security Gate: Enable custom client aliases (e.g. claude-px, fcc-claude)
#   0 / false: Strict safety mode (arbitrary strings resolve to base binaries)
#   1 / true : Custom aliases mode (allows custom binaries and alias names)
HERDR_JEV_ALLOW_ALIASES=0

# Map custom client aliases (e.g. claude-px, fcc-claude, my-codex) to base kinds:
#   JSON map format:
#     HERDR_JEV_ALIASES='{"claude-px":"claude","fcc-claude":"claude"}'
#   Individual environment variable format:
#     HERDR_JEV_ALIAS_CLAUDE_PX=claude
#     HERDR_JEV_ALIAS_FCC_CLAUDE=claude
#
# Override executable binary path for any client or alias:
#   HERDR_JEV_CLAUDE_BIN=fcc-claude
#   HERDR_JEV_BIN_CLAUDE_PX=claude-px

# ------------------------------------------------------------------------------
# 5. Model Overrides (Optional: Highest Precedence over models.json)
# ------------------------------------------------------------------------------
# Claude Code models
HERDR_JEV_CLAUDE_ADVISOR=
HERDR_JEV_CLAUDE_IMPLEMENTER=
HERDR_JEV_CLAUDE_REVIEWER=
HERDR_JEV_CLAUDE_RESEARCHER=

# Codex CLI models
HERDR_JEV_CODEX_ADVISOR=
HERDR_JEV_CODEX_IMPLEMENTER=
HERDR_JEV_CODEX_REVIEWER=
HERDR_JEV_CODEX_RESEARCHER=

# AntiGravity models
HERDR_JEV_ANTIGRAVITY_ADVISOR=
HERDR_JEV_ANTIGRAVITY_IMPLEMENTER=
HERDR_JEV_ANTIGRAVITY_REVIEWER=
HERDR_JEV_ANTIGRAVITY_RESEARCHER=

# ------------------------------------------------------------------------------
# 6. Subagent Execution & Split Direction (Optional)
# ------------------------------------------------------------------------------
# Controls whether subagents run in a split pane side-by-side or inline:
#   1 / true : Spawn in a split pane inside Herdr (default when in Herdr)
#   0 / false: Execute inline directly in the current terminal or CLI session
HERDR_JEV_SPLIT_SUBAGENTS=1

# Direction of the split pane when split is enabled:
#   auto : Jev decides based on role (researcher/implementer: right, reviewer: down)
#   right: Force vertical split to the right
#   down : Force horizontal split downward
HERDR_JEV_SPLIT_DIRECTION=auto

# ------------------------------------------------------------------------------
# 7. Cross-Harness Delegation & Quota Cascade (Optional)
# ------------------------------------------------------------------------------
# Controls whether one harness/client can delegate stages or subagents to another:
#   0 / false / disabled : Inactive (clients only delegate to themselves)
#   1 / true / auto      : Active (Jev decides optimal client per role dynamically)
#   array / list         : Universal peer list with priority order:
#                            HERDR_JEV_CROSS_HARNESS="codex,antigravity"
#                            HERDR_JEV_CROSS_HARNESS='["codex","antigravity"]'
#   mapping string / JSON: Directional peer matrix:
#                            HERDR_JEV_CROSS_HARNESS="claude:codex,antigravity;codex:claude"
#                            HERDR_JEV_CROSS_HARNESS='{"claude":["codex","antigravity"]}'
#
# Quota-Safe Cascade Guarantee:
# When delegating to a peer client in the array/mapping, if that peer runs out of quota
# (circuit breaker active or all models exhausted), Herdr-Jev automatically cascades to the
# next healthy peer in the array. If all peers are exhausted, it safely returns to the
# source harness (current client) so execution never fails.
HERDR_JEV_CROSS_HARNESS=0
