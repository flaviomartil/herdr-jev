  "cards": [
    {
      "dot": "cyan",
      "title": "Launcher guards",
      "items": [
        "In-tab grid tracks worker tiles per caller pane",
        "Readiness wait matches the harness prompt before dispatch",
        "Trust dialog detection stops the launch and hands off to peer-message",
        "Worktree option creates a sibling git worktree for the peer"
      ]
    },
    {
      "dot": "amber",
      "title": "Alerts and reports",
      "items": [
        "Notify dedupes by cooldown, then Herdr native, optional hook and opt-in escalation",
        "Escalation counts only when the native status turns blocked",
        "Routines run standup --auto and daily on a schedule",
        "Daily and standup keep their output in the state dir"
      ]
    },
    {
      "dot": "violet",
      "title": "Office rate policy",
      "items": [
        "Classifications are cached by the last 30 cleaned lines",
        "Working desks once a minute, idle desks after two stable ticks",
        "A cap of 20 calls per minute bounds cost to 1200 an hour"
      ]
    },
    {
      "dot": "rose",
      "title": "Safety rails",
      "items": [
        "Test guard blocks live herdr, real hooks and unmocked standup in tests",
        "Review gate needs deterministic verify before independent judge",
        "TypeSafe key comes from the vault, never from the repository"
      ]
    }
  ]
}